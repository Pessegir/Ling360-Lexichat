# Lexi-Chat — server-side secrets (operator-supplied default key)
#
# Copy this to `.streamlit/secrets.toml` for local dev, OR paste the same
# key into the app's "Secrets" box on Streamlit Community Cloud
# (Manage app → Settings → Secrets). secrets.toml is gitignored.
#
# When GEMINI_API_KEY is set here, the AI host works out of the box for
# every visitor — no one has to bring their own key. The key is only ever
# used server-side for the API call; it is never sent to the browser.
# Leave it unset and the app runs in scripted Demo mode by default.
#
# Free key: https://aistudio.google.com/apikey

GEMINI_API_KEY = "paste-your-free-gemini-key-here"

# OPTIONAL extra free providers. Supply any of these and the app fans across
# their independent free tiers (ChainClient): when one provider's daily quota
# is spent, the next takes over — multiplying total free headroom. Gemini
# leads (best Turkish); the rest are fallbacks.
# OpenRouter (free :free models):     https://openrouter.ai/keys
# Hugging Face (Inference Providers): https://huggingface.co/settings/tokens
# Deepseek (signup credits):          https://platform.deepseek.com/api_keys
# OPENROUTER_API_KEY = ""
# HUGGINGFACE_API_KEY = ""
# DEEPSEEK_API_KEY = ""
